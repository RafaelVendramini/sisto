# Copie este arquivo para .env e ajuste os valores localmente.
# Nunca versione o .env nem coloque valores reais aqui.

# Porta HTTP da API
PORT=3000

# Ambiente de execução (development | test | production)
NODE_ENV=development

# Conexão com o PostgreSQL (Prisma). Formato:
#   postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Banco de desenvolvimento: sisto
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/sisto"

# ---------------------------------------------------------------------------
# Banco de TESTES (separado, para não sujar o banco de desenvolvimento)
# Crie um arquivo .env.test (também ignorado pelo Git) contendo apenas:
#
#   DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/sisto_test"
#
# Variáveis definidas pelo .env.test têm prioridade sobre o .env.
# `npm run db:test:reset` recria o banco sisto_test e aplica as migrations.
# ---------------------------------------------------------------------------
