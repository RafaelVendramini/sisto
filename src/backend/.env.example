# Copie este arquivo para .env e ajuste os valores localmente.
# Nunca versione o .env nem coloque valores reais aqui.

# Porta HTTP da API
PORT=3000

# Ambiente de execução (development | test | production)
NODE_ENV=development

# Conexão com o PostgreSQL (Prisma). Formato:
#   postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Banco de desenvolvimento: sisto
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/sisto"

# ---------------------------------------------------------------------------
# Autenticação (POST /auth/login) — Issue #10
# Segredo usado para assinar os tokens JWT (HS256). OBRIGATÓRIO: sem ele (ou
# com menos de 32 caracteres, ou ainda com o valor de exemplo "TROQUE_...") o
# login responde 500 e nenhum token é emitido.
# O token expira em 8 horas, sem refresh (RNF03) — valor fixo no código.
# Gere um segredo forte e exclusivo para cada ambiente com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O valor abaixo é apenas EXEMPLO — nunca use-o de verdade.
JWT_SECRET="TROQUE_POR_UM_SEGREDO_ALEATORIO_DE_96_CARACTERES_HEX"

# ---------------------------------------------------------------------------
# CORS — origens do front-end autorizadas a chamar a API pelo navegador (#14)
# Lista separada por vírgula, cada item no formato esquema://host[:porta]
# (sem barra final, sem caminho). '*' NÃO é aceito.
#   - Ausente/vazia em development/test: usa http://localhost:5173 (Vite).
#   - Ausente/vazia em production: nenhuma origem é liberada (falha fechada)
#     e a API registra um aviso na inicialização. Defina a URL real do front.
# Exemplo com duas origens:
#   CORS_ORIGIN="http://localhost:5173,https://sisto.exemplo"
CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Seed de usuários (`npm run db:seed`) — Subtask #9
# Todos os usuários são criados com status ATIVO.
#   - NODE_ENV=production: cria SOMENTE o usuário de Gestão (administrador);
#     SEED_SENHA_USUARIOS não é exigida.
#   - Outros ambientes (development, test): cria 1 usuário por perfil
#     (Gestão + Professor, Tutor, Pedagógico e Técnico-administrativo fictícios).
# Senhas: mínimo 8 caracteres (RN10) e máximo 72 bytes (limite técnico do
# bcrypt; letras acentuadas contam 2 bytes), gravadas só como hash bcrypt
# (RNF03). Os valores abaixo são EXEMPLOS: senhas começando com "TROQUE_" são
# recusadas. O seed aborta, sem gravar nada, se alguma variável exigida faltar
# ou for inválida.
#
# Usuário de Gestão = primeiro administrador do sistema (inclusive em produção).
# Em produção, use um e-mail institucional e uma senha forte e exclusiva.
SEED_GESTAO_EMAIL="gestao@sisto.exemplo"
SEED_GESTAO_SENHA="TROQUE_ESTA_SENHA"
#
# Senha única dos demais usuários fictícios (e-mails *@sisto.exemplo definidos
# no seed). Não usada em produção.
SEED_SENHA_USUARIOS="TROQUE_ESTA_SENHA_TAMBEM"
#
# Executar de novo é seguro: usuários já existentes (mesmo e-mail) não são
# alterados — senha, perfil e status são mantidos; só os ausentes são criados.
# ATENÇÃO: o seed identifica a Gestão pelo e-mail. Trocar SEED_GESTAO_EMAIL e
# rodar o seed de novo cria um SEGUNDO usuário GESTAO, e o antigo continua
# ATIVO (o seed não altera nem desativa usuários existentes). Para trocar o
# administrador, use o sistema (cadastro/bloqueio de usuários), não o seed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Script de recuperação da Gestão — Issue #80. Último recurso, quando nenhum
# usuário Gestão consegue entrar:
#   npm run --silent recuperar-gestao -- --email <e-mail-da-gestao>
# No PowerShell, use npm.cmd (o npm.ps1 descarta o `--`); passo a passo em
# docs/deploy.md. O script NÃO lê este arquivo: a DATABASE_URL e a senha
# temporária são definidas no próprio terminal, na hora de executar.
# Senha temporária do usuário Gestão (mín. 8 caracteres, máx. 72 bytes); só é
# lida pelo script, nunca por argumento. Remova a variável depois. Nunca
# versione um valor. Fica comentada aqui de propósito, só como referência.
# RECUPERACAO_SENHA_TEMPORARIA=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Banco de TESTES (separado, para não sujar o banco de desenvolvimento)
# Crie um arquivo .env.test (também ignorado pelo Git) contendo apenas:
#
#   DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/sisto_test"
#
# Variáveis definidas pelo .env.test têm prioridade sobre o .env.
# `npm run db:test:reset` recria o banco sisto_test e aplica as migrations.
# ---------------------------------------------------------------------------
