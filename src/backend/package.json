{
  "name": "sisto-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do Sisto — gestão de ocorrências escolares",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:reset": "node prisma/reset-test-db.js",
    "recuperar-gestao": "node prisma/recuperar-gestao-cli.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
